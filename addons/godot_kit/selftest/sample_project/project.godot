; Sample project for the kit's self-test (selftest/run_selftest.py copies it
; to a temp folder and vendors the kit into it).

config_version=5

[application]

config/name="Godot Kit Sample"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameClock="*res://game/game_clock.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
