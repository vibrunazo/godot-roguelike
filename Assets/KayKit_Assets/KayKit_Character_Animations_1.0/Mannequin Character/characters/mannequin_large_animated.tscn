code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform float Threshold : hint_range(0.0, 1.0) = 0.0;
uniform sampler2D NoiseTexture : source_color, filter_linear_mipmap;



void fragment() {
// FloatParameter:5
	float n_out5p0 = Threshold;


// Input:6
	vec2 n_out6p0 = UV;
	float n_out6p1 = n_out6p0.r;


// Input:12
	float n_out12p0 = TIME;


// FloatOp:13
	float n_in13p1 = 2.00000;
	float n_out13p0 = n_out12p0 * n_in13p1;


// FloatOp:11
	float n_out11p0 = n_out6p1 - n_out13p0;


// VectorCompose:10
	float n_in10p1 = 0.00000;
	vec2 n_out10p0 = vec2(n_out11p0, n_in10p1);


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out10p0 * n_in9p1 + UV;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(NoiseTexture, n_out9p0);


// FloatOp:7
	float n_out7p0 = n_out2p0.x - n_out6p1;


// Step:4
	float n_out4p0 = step(n_out5p0, n_out7p0);


// Output:0
	ALPHA = n_out4p0;


}
"
