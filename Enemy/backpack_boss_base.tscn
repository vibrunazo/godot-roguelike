[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.4875
height = 3.96

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_hurtbox"]
radius = 1.0
height = 4.0

[node name="BackpackBossBase" type="CharacterBody3D" node_paths=PackedStringArray("mesh_mount", "attribute_component", "knockback_component", "animation_tree", "state_machine", "ai_state_machine", "navigation_agent_3d", "collision_shape_3d", "hurtbox", "color_component", "stun_state", "defeat_state") groups=["enemy"] editor_description="ABSTRACT BASE TEMPLATE for backpack bosses: one big brute-rig character carrying two riders in backpacks on its back. It holds what they share: body, components, the rider controller (BackpackRiders, empty here) and the throw and summon attacks with their AI. A concrete boss inherits it, puts a rider scene (Enemy/Riders/rider_*.tscn) in each backpack and lists them on BackpackRiders, then sets its palette, stats, its own attacks and AIPursue's body_state. Never spawn it directly."]
collision_layer = 3
collision_mask = 5
script = ExtResource("1_char")
mesh_mount = NodePath("AnimationAnchor")
attribute_component = NodePath("AttributeComponent")
knockback_component = NodePath("KnockbackComponent")
animation_tree = NodePath("AnimationAnchor/AnimatedBrute/Enemy_Large/AnimationTree")
state_machine = NodePath("StateMachine")
ai_state_machine = NodePath("AIStateMachine")
navigation_agent_3d = NodePath("NavigationAgent3D")
collision_shape_3d = NodePath("CollisionShape3D")
hurtbox = NodePath("Hurtbox")
color_component = NodePath("CharacterColorComponent")
stun_state = NodePath("StateMachine/EnemyStun")
defeat_state = NodePath("StateMachine/EnemyDefeat")

[node name="AnimationAnchor" type="Node3D" parent="."]
transform = Transform3D(1.32, 0, 0, 0, 1.32, 0, 0, 0, 1.32, 0, 0, 0)

