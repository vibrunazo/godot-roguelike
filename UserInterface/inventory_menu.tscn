[gd_scene format=3 uid="uid://dinventory01"]

[ext_resource type="Script" path="res://UserInterface/inventory_menu.gd" id="1_inv"]
[ext_resource type="PackedScene" path="res://UserInterface/upgrade_icon.tscn" id="2_card"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 32.0
content_margin_top = 28.0
content_margin_right = 32.0
content_margin_bottom = 28.0
bg_color = Color(0.101961, 0.101961, 0.121569, 0.960784)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.309804, 0.658824, 0.803922, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="InventoryMenu" type="PanelContainer"]
custom_minimum_size = Vector2(620, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")
script = ExtResource("1_inv")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="InventoryTitle" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
bbcode_enabled = true
text = "[center]EQUIPMENT[/center]"
fit_content = true

[node name="Content" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="GearList" type="ItemList" parent="VBox/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 260)
layout_mode = 2
size_flags_vertical = 3

[node name="DetailsCard" parent="VBox/Content" instance=ExtResource("2_card")]
unique_name_in_owner = true
layout_mode = 2
card_mode = 1
