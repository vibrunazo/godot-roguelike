; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GDTV-Roguelike"
run/main_scene="res://Levels/level_2.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://cai13gaviuuvu"

[autoload]

GlobalVars="*res://Singletons/GlobalVars.gd"
SceneTransition="*res://Singletons/scene_transition.tscn"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Components/": "blue",
"res://Enemy/": "purple",
"res://Levels/": "orange",
"res://Player/": "yellow",
"res://Singletons/": "green",
"res://StateMachine/": "teal",
"res://UserInterface/": "pink"
}

